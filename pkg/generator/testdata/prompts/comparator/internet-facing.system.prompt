          "SL": {"type": "integer", "enum": [1, 3, 5, 6, 9], "description": "How technically skilled is this group of threat agents?"},
          "M": {"type": "integer", "enum": [1, 4, 9], "description": "How motivated is this group of threat agents to find and exploit this vulnerability?"},
          "O": {"type": "integer", "enum": [0, 4, 7, 9], "description": "What resources and opportunities are required for this group of threat agents to find and exploit this vulnerability?"},
